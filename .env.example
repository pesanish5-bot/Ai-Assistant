# Local private state. Relative paths resolve from the project directory.
ULTRON_DATA_DIR=.ultron

# Canonical human-readable persistent memory. This path is local and ignored.
ULTRON_VAULT_DIR=.ultron/vault

# Optional IANA timezone used for daily plans. Blank uses the system timezone.
ULTRON_TIMEZONE=

# Comma-separated GitHub repositories in owner/repository form.
ULTRON_GITHUB_REPOSITORIES=

# Required before speaker enrollment or locked-session authentication.
# Set this privately or pass --name/--speaker-name to the relevant voice command.
ULTRON_SPEAKER_NAME=

# Optional. Public repositories work without a token but are rate limited.
GITHUB_TOKEN=

# Optional. Enables authenticated loopback POSTs from the local voice/background
# process to the browser HUD. Use the same random value (at least 32 characters)
# in both processes. Leave empty to keep native event POSTs disabled.
ULTRON_LOCAL_EVENT_TOKEN=

# Optional private cache location for local STT, VAD, TTS, and speaker models.
# When omitted, Ultron uses ~/.cache/ultron-voice/models.
# ULTRON_VOICE_MODEL_DIR=D:/UltronData/voice-models
